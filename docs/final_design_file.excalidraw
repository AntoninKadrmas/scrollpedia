      "groupIds": [],
      "frameId": "IZxdd6hDGuwIduNmEwONh",
      "index": "aTrkr",
      "roundness": null,
      "seed": 830001800,
      "version": 166,
      "versionNonce": 2069591176,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794559235864,
      "created": 1794559126591,
      "link": null,
      "locked": false,
      "text": "Cras imperdiet lorem quis libero congue\nhendrerit. Pellentesque iaculis orci sed\nligula volutpat malesuada. Pellentesque\nac leo a nibh tincidunt ultricies non\nnec felis. Nunc euismod nulla quis\npulvinar molestie. \n\nVestibulum mattis, elit ac vulputate\ndictum, lacus nisl posuere metus, a\nornare magna dui eget purus. Aenean in\nmetus eu massa facilisis ullamcorper.\nMauris nec orci lobortis, maximus\ntortor sit amet, pretium sem. \n\nNullam nec pretium quam. Proin magna\nlibero, tempor at ex quis, condimentum\ntincidunt ante. Maecenas id neque\ngravida eros tempus sollicitudin.\nPhasellus malesuada at tortor ut\nrutrum. Nullam quis interdum libero.\nDuis blandit lobortis felis, eget\ntempus nunc ornare vitae. Praesent\nconsequat est a quam imperdiet,\nfringilla volutpat lorem auctor.\nPraesent at mauris faucibus, maximus\norci vel, dictum purus. Vestibulum a leo\nnisl.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cras imperdiet lorem quis libero congue hendrerit. Pellentesque iaculis orci sed ligula volutpat malesuada. Pellentesque ac leo a nibh tincidunt ultricies non nec felis. Nunc euismod nulla quis pulvinar molestie. \n\nVestibulum mattis, elit ac vulputate dictum, lacus nisl posuere metus, a ornare magna dui eget purus. Aenean in metus eu massa facilisis ullamcorper. Mauris nec orci lobortis, maximus tortor sit amet, pretium sem. \n\nNullam nec pretium quam. Proin magna libero, tempor at ex quis, condimentum tincidunt ante. Maecenas id neque gravida eros tempus sollicitudin. Phasellus malesuada at tortor ut rutrum. Nullam quis interdum libero. Duis blandit lobortis felis, eget tempus nunc ornare vitae. Praesent consequat est a quam imperdiet, fringilla volutpat lorem auctor. Praesent at mauris faucibus, maximus orci vel, dictum purus. Vestibulum a leo nisl.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
